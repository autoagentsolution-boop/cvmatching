# ============================================================================
# Server-only environment variables. Never expose to the client.
# Copy this file to .env.local for local development.
# In production, configure these in Vercel Project Settings -> Environment Variables.
# ============================================================================

# --- Shared LLM provider keys (Production scope only on Vercel) -------------
# These power the "Use shared key" path. Keep Production-only so Preview
# deploys force BYOK and cannot leak prod keys through PR previews.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Generate AUTH_SECRET with: openssl rand -base64 32
# Required in production; optional in dev (defaults to dev-only secret).
AUTH_SECRET=
# Auth.js infers AUTH_URL from request headers on Vercel; set only if needed.
AUTH_URL=http://localhost:3000

# --- Google OAuth (required for shared-key login) ----------------------------
# Cloud Console -> Credentials -> OAuth 2.0 Client. Add production callback:
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel KV (quota + IP rate limit) ---------------------------------------
# Provision: Vercel Dashboard -> Storage -> Create KV -> Link to project.
# Pull locally: pnpm dlx vercel env pull .env.local
# When unset, quota/rate-limit gracefully fail-open (allow all, log warning).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Emergency kill switch ---------------------------------------------------
# Set to "1" to force /api/analyze and /api/generate-cv to 503 on shared-key
# path. Users can still use BYOK. Useful if shared key gets abused.
DISABLE_SHARED_KEY=

# --- LLM debug logging (privacy-sensitive — DO NOT enable in production) -----
# Set to "1" to log fragments of raw LLM output when parsing fails. The output
# may contain analysis content about user CVs/JDs. Leave unset in production.
LOG_LLM_DEBUG=

# --- CSP rollout mode --------------------------------------------------------
# Set to "1" to send Content-Security-Policy-Report-Only (collect violations
# without breaking the page). Unset → enforce mode (block violations).
# Use for staged rollout when adding new external dependencies.
CSP_REPORT_ONLY=

# --- Admin dashboard access (/admin/usage) -----------------------------------
# Comma-separated user IDs (session.user.id) allowed to view usage metering.
# Non-admin signed-in users get 404 to hide existence. Unset → no admin access.
ADMIN_USER_IDS=

# --- CV embed cache HMAC key (v0.3 Phase 2) ----------------------------------
# Generate: openssl rand -hex 32
# Required in production for HMAC-keyed embed cache keys in KV (Phase 2+).
# Phase 2 routes fail closed (503) if missing in prod. Rotate quarterly —
# old cache keys auto-expire within 6h TTL.
EMBED_CACHE_SECRET=

# --- Cron secret (v0.3 Phase 4) ----------------------------------------------
# Vercel Pro auto-injects this for cron routes (no manual setup needed in prod).
# For local smoke tests only — generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Spend / abuse alert webhook ---------------------------------------------
# Receives JSON POST when shared-key usage crosses a daily threshold. Dedupes
# per UTC day per threshold. Configure for Slack/Discord/generic incoming hook.
ALERT_WEBHOOK_URL=
# Trigger when shared-key calls (across all users) exceed this on a single day.
ALERT_SHARED_DAILY_CALLS=
# Trigger when shared-key $-spend exceeds this on a single day (USD, decimal).
ALERT_SHARED_DAILY_COST_USD=
